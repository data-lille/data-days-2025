{%- set MENU = (
  ('index', ('À propos', 'About')),
  ('venue', ('Venir', 'Venue')),
  ('sponsors_listing', ('Sponsors', 'Sponsors')),
  ('conduct', ('Code de conduite', 'Code of Conduct')),
) -%}
{%- set TITLES = dict(MENU + (

)) -%}

{%- set title = title or dict(TITLES).get(page_name, ['', ''])[1 if lang == 'en' else 0] -%}

<!DOCTYPE html>

<html lang="{{ lang }}">
  <head>
    {% block head %}
    <title>{{ 'Data Days Lille 2027, le 26 mars à Lille' if page_name == 'index' else title ~ ' - Data Days Lille 2027' }}</title>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <link
      rel="shortcut icon"
      href="{{ url_for('static', filename='images/favicon.png') }}"
    />
    <link
      rel="stylesheet"
      href="{{ url_for('static', filename='css/style.css') | version }}"
    />
    <script>
      /* Stupid hack for iOS :hover */ document.addEventListener(
        "touchstart",
        function () {},
        true
      );
    </script>

{%- set SITE = 'https://days.data-lille.fr' -%}
    {%- set meta_description = meta_description | default("Data Days Lille 2027 : une journée dédiée à la data et à l'IA le 26 mars 2027 à l'Université Catholique de Lille. Conférences, quick talks, ateliers pratiques et stands sponsors.") -%}
    {%- set meta_title = 'Data Days Lille 2027, le 26 mars à Lille' if page_name == 'index' else title ~ ' - Data Days Lille 2027' -%}
    {%- set canonical = SITE ~ ('/' if page_name == 'index' else request.path) -%}
    {%- set og_image = SITE ~ (url_for('static', filename='images/og-2027.jpg') | version) -%}
    <meta name="description" content="{{ meta_description }}" />
    <meta name="author" content="Data Lille" />
    <meta name="keywords" content="data, IA, intelligence artificielle, machine learning, data engineering, conférence, atelier, Lille, Hauts-de-France, 2027" />
    <meta name="theme-color" content="#e9006e" />
    <link rel="canonical" href="{{ canonical }}" />
    <link rel="apple-touch-icon" href="{{ url_for('static', filename='images/favicon.png') }}" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Data Days Lille" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:url" content="{{ canonical }}" />
    <meta property="og:title" content="{{ meta_title }}" />
    <meta property="og:description" content="{{ meta_description }}" />
    <meta property="og:image" content="{{ og_image }}" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Data Days Lille, 26 mars 2027, Université Catholique de Lille, conférences, quick talks, ateliers" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ meta_title }}" />
    <meta name="twitter:description" content="{{ meta_description }}" />
    <meta name="twitter:image" content="{{ og_image }}" />
    <meta name="twitter:image:alt" content="Data Days Lille, 26 mars 2027, Université Catholique de Lille" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Event",
      "name": "Data Days Lille 2027",
      "description": "Une journée dédiée à la data et à l'IA : conférences, quick talks, ateliers pratiques et stands sponsors.",
      "startDate": "2027-03-26",
      "endDate": "2027-03-26",
      "eventStatus": "https://schema.org/EventScheduled",
      "eventAttendanceMode": "https://schema.org/OfflineEventAttendanceMode",
      "url": "{{ SITE }}/",
      "image": "{{ og_image }}",
      "location": {
        "@type": "Place",
        "name": "Université Catholique de Lille",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "60 boulevard Vauban",
          "postalCode": "59800",
          "addressLocality": "Lille",
          "addressCountry": "FR"
        }
      },
      "organizer": {"@type": "Organization", "name": "Data Lille", "url": "https://www.data-lille.fr"}
    }
    </script>
    {% endblock head %}
  </head>

  <body id="{{ page_name }}">
    {% block header %}
    <nav>
      <div class="logo">
        <a href="/">
          <img src="/2027/static/images/data_days_banner.png"></img>
        </a>
      </div>
      <div class="menu-overlay" id="menu-overlay">
        <ul class="menu">
        {% for endpoint, (title_fr, title_en) in MENU %}
          <li class="{{ 'active' if page_name == endpoint }}">
            <a
              href="{{ url_for(endpoint, lang=lang) }}"
              >{{ title_en if lang == 'en' else title_fr }}</a
            >
          </li>
        {% endfor %}
          <li class="dropdown">
            <a href="#" class="dropdown-toggle">
              {{ 'Éditions précédentes' if lang == 'fr' else 'Previous editions' }}
              <span class="dropdown-arrow">▼</span>
            </a>
            <ul class="dropdown-menu">
              <li><a href="/2026/">2026</a></li>
              <li><a href="/2025/">2025</a></li>
            </ul>
          </li>
        </ul>
      </div>

      <div class="wrapper-right">
        <a class="button" href="{{ url_for('sponsors_listing', lang=lang) }}">Devenir sponsor</a>
        <div class="menu-toggle" id="menu-toggle">
          <div class="bar"></div>
          <div class="bar"></div>
          <div class="bar"></div>
        </div>
      </div>

    </nav>
    {% endblock header %}

    <main>{% block content %}{% endblock content %}</main>

    {% block footer %}
    <footer>
      <ul>
        <li><a href="mailto:meetup.data.lille@gmail.com">Email</a></li>
        <li>
          <a href="https://github.com/data-lille/data-days-2025">GitHub</a>
          forké depuis
          <a href="https://github.com/AFPy/pyconfr-2024">PyconFr</a>
        </li>
        <li><a href="https://frozen-flask.readthedocs.io/">Frozen-Flask</a></li>
        <li><a href="https://data-lille.fr/">© 2027 Data Lille</a></li>
      </ul>
      <p class="footer-photo-notice">Un reportage photographique et vidéo sera réalisé lors de l'événement. Les images pourront être diffusées sur le site web et les réseaux sociaux de Data Lille. Un dispositif d'opt-out sera disponible à l'accueil.</p>
    </footer>
    {% endblock footer %}
  </body>

  <script>
const menuToggle = document.getElementById('menu-toggle');
const menuOverlay = document.getElementById('menu-overlay');

menuToggle.addEventListener('click', function(event) {
  this.classList.toggle('active');
  menuOverlay.classList.toggle('active');
  if (menuOverlay.classList.contains('active')) {
    document.body.style.overflow = 'hidden'; // Empêche le défilement
  } else {
    document.body.style.overflow = ''; // Réinitialise le défilement
  }

  event.stopPropagation(); // Empêche la propagation du clic pour qu'il ne ferme pas immédiatement le menu
});

document.addEventListener('click', function(event) {
    menuToggle.classList.remove('active');
    menuOverlay.classList.remove('active');
    document.body.style.overflow = ''; // Réinitialise le défilement
});

// Gestion du dropdown au clic (desktop et mobile)
const dropdownToggles = document.querySelectorAll('.dropdown-toggle');
dropdownToggles.forEach(function(toggle) {
  toggle.addEventListener('click', function(event) {
    event.preventDefault();
    event.stopPropagation();
    
    const dropdown = this.closest('.dropdown');
    const isOpen = dropdown.classList.contains('open');
    
    // Ferme tous les autres dropdowns
    document.querySelectorAll('.dropdown').forEach(function(d) {
      d.classList.remove('open');
    });
    
    // Toggle le dropdown actuel
    if (!isOpen) {
      dropdown.classList.add('open');
    }
  });
});

// Ferme les dropdowns quand on clique ailleurs
document.addEventListener('click', function(event) {
  if (!event.target.closest('.dropdown')) {
    document.querySelectorAll('.dropdown').forEach(function(d) {
      d.classList.remove('open');
    });
  }
});
  </script>
</html>
